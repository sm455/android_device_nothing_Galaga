type vendor_hal_camera_default, domain;
type vendor_hal_camera_default_exec, exec_type, vendor_file_type, file_type;

hal_server_domain(vendor_hal_camera_default, hal_graphics_allocator)
hal_server_domain(vendor_hal_camera_default, hal_mtk_isphal)
hal_server_domain(vendor_hal_camera_default, vendor_hal_noth_camera)
init_daemon_domain(vendor_hal_camera_default)

binder_call(vendor_hal_camera_default, hal_graphics_allocator_default)
binder_call(vendor_hal_camera_default, cameraserver)
binder_call(cameraserver, vendor_hal_camera_default)
binder_call(vendor_hal_camera_default, mtk_hal_camera)
binder_call(mtk_hal_camera, vendor_hal_camera_default)
allow vendor_hal_camera_default platform_app:binder call;

getprop(vendor_hal_camera_default, camera_config_prop)

allow vendor_hal_camera_default kmsg_device:chr_file { read write getattr open };
allow vendor_hal_camera_default apusys_device:chr_file rw_file_perms;
allow vendor_hal_camera_default vendor_data_file:dir create_dir_perms;
allow vendor_hal_camera_default vendor_data_file:file create_file_perms;
allow vendor_hal_camera_default hal_graphics_allocator_default_tmpfs:file { read write map };
allow vendor_hal_camera_default fwk_camera_service:service_manager find;

allow vendor_hal_camera_default sysfs:file { read write getattr open };
allow vendor_hal_camera_default sysfs:dir { open search };
allow vendor_hal_camera_default proc:file { read write getattr open };
allow vendor_hal_camera_default proc:dir { open search };
allow vendor_hal_camera_default proc_meminfo:file r_file_perms;
