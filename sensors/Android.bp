cc_library_shared {
    name: "sensors.nothing",
    defaults: ["hidl_defaults"],
    srcs: [
        "Sensor.cpp",
        "SensorsSubHal.cpp",
    ],
    shared_libs: [
        "android.hardware.sensors@1.0",
        "android.hardware.sensors@2.0",
        "android.hardware.sensors@2.0-ScopedWakelock",
        "android.hardware.sensors@2.1",
        "libcutils",
        "libfmq",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libpower",
        "libutils",
    ],
    static_libs: [
        "android.hardware.sensors@1.0-convert",
        "android.hardware.sensors@2.X-multihal",
    ],
    cflags: [
        "-DLOG_TAG=\"sensors.nothing\"",
        "-DPANEL_SINGLE_TAP_PATH=\"/sys/devices/platform/soc/11013000.spi3/spi_master/spi3/spi3.0/fts_gesture_single_tap_pressed\"",
        "-DPANEL_SINGLE_TAP_ENABLED_PATH=\"/sys/devices/platform/soc/11013000.spi3/spi_master/spi3/spi3.0/fts_gesture_single_tap_enabled\"",
        "-DPANEL_SINGLE_TAP_COORDS_PATH=\"/proc/touchpanel/gesture_code\"",
        "-DPANEL_UDFPS_PATH=\"/sys/devices/platform/soc/11013000.spi3/spi_master/spi3/spi3.0/fts_fod_pressed\"",
        "-DPANEL_UDFPS_ENABLED_PATH=\"/sys/devices/platform/soc/11013000.spi3/spi_master/spi3/spi3.0/fts_fod_enabled\"",
    ],
    vendor: true,
}
